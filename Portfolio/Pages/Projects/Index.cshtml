@page "/projects"
@model Portfolio.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Projects | Kernel Gallery";
    ViewData["Description"] = "Exploratory project branches covering product thinking, ASP.NET, C#, and infrastructure.";
    ViewData["CanonicalPath"] = "/projects";
}

<section class="page-header split-header">
    <div>
        <p class="system-label">branch.index</p>
        <h1>Projects as branching systems, not static thumbnails.</h1>
    </div>
    <p>Each case study shows the role, phase, explored branches, and the technical kernel behind the product surface.</p>
</section>

@if (Model.Projects.Count > 0)
{
    var featured = Model.Projects.First();
    <section class="featured-build" aria-labelledby="featured-build-title">
        <div>
            <p class="system-label">featured.build</p>
            <h2 id="featured-build-title">@featured.Title</h2>
            <p>@featured.Summary</p>
            <a class="button button-primary" asp-page="/Projects/Details" asp-route-slug="@featured.Slug">Open case study</a>
        </div>
        <dl class="showcase-stats" aria-label="Featured project signals">
            <div>
                <dt>phase</dt>
                <dd>@featured.Phase</dd>
            </div>
            <div>
                <dt>role</dt>
                <dd>@featured.Role</dd>
            </div>
            <div>
                <dt>branches</dt>
                <dd>@((featured.Branches ?? []).Count)</dd>
            </div>
        </dl>
    </section>
}

<section class="branch-grid branch-grid-wide">
    @foreach (var project in Model.Projects)
    {
        <article class="branch-card showcase-card">
            <a class="branch-visual-link" asp-page="/Projects/Details" asp-route-slug="@project.Slug" aria-label="Open @project.Title case study">
                @if (!string.IsNullOrWhiteSpace(project.Visual))
                {
                    <img src="@project.Visual" alt="@project.VisualAlt" loading="lazy" decoding="async" />
                }
                <span class="branch-count">@((project.Branches ?? []).Count) branches</span>
            </a>
            <div class="branch-body">
                <div class="meta-row">
                    <span>@project.Phase</span>
                    <span>@project.Role</span>
                </div>
                <h2><a asp-page="/Projects/Details" asp-route-slug="@project.Slug">@project.Title</a></h2>
                <p>@project.Summary</p>
                <div class="showcase-proof" aria-label="@project.Title proof points">
                    <span>Product direction</span>
                    <span>Technical kernel</span>
                    <span>Branch notes</span>
                </div>
                <div class="branch-list" aria-label="Project branches">
                    @foreach (var branch in project.Branches ?? [])
                    {
                        <span>@branch</span>
                    }
                </div>
            </div>
        </article>
    }
</section>

<section class="project-timeline" aria-labelledby="project-timeline-title">
    <div>
        <p class="system-label">evolution.timeline</p>
        <h2 id="project-timeline-title">How the portfolio system is expanding.</h2>
    </div>
    <ol>
        @foreach (var project in Model.Projects)
        {
            <li>
                <time datetime="@project.Date.ToString("yyyy-MM-dd")">@project.Date.ToString("yyyy.MM")</time>
                <strong>@project.Title</strong>
                <span>@project.Phase</span>
            </li>
        }
    </ol>
</section>
