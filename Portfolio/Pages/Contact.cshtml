@page "/contact"
@{
    ViewData["Title"] = "Contact | Kernel Gallery";
    ViewData["Description"] = "Contact Sawyer Cawthon about design-minded ASP.NET projects, portfolio work, and collaboration.";
    ViewData["CanonicalPath"] = "/contact";
}

<section class="page-header split-header">
    <div>
        <p class="system-label">network.request</p>
        <h1>Send a clear signal.</h1>
    </div>
    <p>Replace the placeholder links with your real inbox, GitHub, LinkedIn, and resume download target before publishing.</p>
</section>

<section class="contact-grid">
    <a href="mailto:hello@example.com">
        <span>Email</span>
        <strong>hello@example.com</strong>
    </a>
    <a href="https://github.com/" rel="me">
        <span>GitHub</span>
        <strong>github.com/your-handle</strong>
    </a>
    <a href="https://www.linkedin.com/" rel="me">
        <span>LinkedIn</span>
        <strong>linkedin.com/in/your-handle</strong>
    </a>
</section>
