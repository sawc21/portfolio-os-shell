@page "/contact"
@model Portfolio.Pages.ContactModel
@{
    ViewData["Title"] = "Contact | Kernel Gallery";
    ViewData["Description"] = "Contact Sawyer Cawthon about AI, cybersecurity research, ASP.NET Core backend work, software development, and collaboration.";
    ViewData["CanonicalPath"] = "/contact";
}

<section class="page-header split-header">
    <div>
        <p class="system-label">network.request</p>
        <h1>Send a clear signal.</h1>
    </div>
    <p>Reach Sawyer through the same professional channels used across the Portfolio OS.</p>
</section>

<section class="contact-grid">
    <a href="mailto:@Model.Profile.Email">
        <span>Email</span>
        <strong>@Model.Profile.Email</strong>
    </a>
    <a href="@Portfolio.Pages.ContactModel.PhoneHref(Model.Profile.Phone)">
        <span>Phone</span>
        <strong>@Model.Profile.Phone</strong>
    </a>
    <a href="@Portfolio.Pages.ContactModel.LocationHref(Model.Profile.Location)">
        <span>Location</span>
        <strong>@Model.Profile.Location</strong>
    </a>
    <a href="@Model.Profile.Links.GitHub" rel="me">
        <span>GitHub</span>
        <strong>@Model.DisplayUrl(Model.Profile.Links.GitHub)</strong>
    </a>
    <a href="@Model.Profile.Links.LinkedIn" rel="me">
        <span>LinkedIn</span>
        <strong>@Model.DisplayUrl(Model.Profile.Links.LinkedIn)</strong>
    </a>
    <a href="@Model.Profile.Links.X" rel="me">
        <span>X</span>
        <strong>@Model.DisplayUrl(Model.Profile.Links.X)</strong>
    </a>
</section>
