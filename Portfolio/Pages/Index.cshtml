@page
@model IndexModel
@{
    ViewData["Title"] = "Sawyer Cawthon | Kernel Gallery";
    ViewData["Description"] = "A graphic-minimalist ASP.NET portfolio for product thinking, full-stack C# work, and self-hosting experiments.";
    ViewData["CanonicalPath"] = "/";
}

<section class="homepage-hub" aria-labelledby="homepage-hub-title">
    <div class="hub-copy">
        <p class="system-label">kernel.gallery / public interface</p>
        <h1 id="homepage-hub-title">A portfolio you can enter, not just scan.</h1>
        <p class="hero-summary">
            I shape product ideas, build the Razor Pages and ASP.NET infrastructure behind them, and turn each project into an explorable branch of the system.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" asp-page="/Projects/Index">Explore projects</a>
            <a class="button button-secondary" asp-page="/Resume">System profile</a>
        </div>
        <nav class="hub-fallback-links" aria-label="Homepage hub destinations">
            <a asp-page="/Projects/Index" data-hub-link="projects">Projects</a>
            <a asp-page="/Blog/Index" data-hub-link="blog">Blog</a>
            <a asp-page="/Resume" data-hub-link="resume">Resume</a>
            <a asp-page="/Contact" data-hub-link="contact">Contact</a>
            <span aria-disabled="true" data-hub-link="lab">Lab planned</span>
        </nav>
    </div>
    <aside class="hub-stage" data-home-hub aria-label="Interactive homepage hub">
        <div class="hub-static-map" aria-hidden="true">
            <span class="hub-node hub-node-projects">Projects</span>
            <span class="hub-node hub-node-blog">Blog</span>
            <span class="hub-node hub-node-resume">Resume</span>
            <span class="hub-node hub-node-contact">Contact</span>
            <span class="hub-node hub-node-lab">Lab</span>
        </div>
        <div class="kernel-panel hub-status-panel" aria-live="polite">
            <div class="panel-topline">
                <span>hub.status</span>
                <strong>progressive</strong>
            </div>
            <p data-hub-status>Projects: Creative branches, case studies, and shipped product thinking.</p>
            <div class="signal-strip" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
            </div>
        </div>
        <noscript>
            <p class="hub-noscript">The visual hub needs JavaScript, but every destination is available through the native links.</p>
        </noscript>
    </aside>
</section>

<section class="branch-section">
    <div class="section-heading">
        <p class="system-label">featured.branches</p>
        <h2>Project branches worth opening.</h2>
    </div>
    <div class="branch-grid">
        @foreach (var project in Model.FeaturedProjects)
        {
            <article class="branch-card">
                @if (!string.IsNullOrWhiteSpace(project.Visual))
                {
                    <img src="@project.Visual" alt="@project.VisualAlt" />
                }
                <div class="branch-body">
                    <div class="meta-row">
                        <span>@project.Phase</span>
                        <span>@project.Role</span>
                    </div>
                    <h3><a asp-page="/Projects/Details" asp-route-slug="@project.Slug">@project.Title</a></h3>
                    <p>@project.Summary</p>
                    <div class="branch-list" aria-label="Project branches">
                        @foreach (var branch in project.Branches ?? [])
                        {
                            <span>@branch</span>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
    <script type="module" src="~/dist/homeHub.js" asp-append-version="true"></script>
}

<section class="log-section">
    <div>
        <p class="system-label">thinking.log</p>
        <h2>Notes from the build process.</h2>
    </div>
    <div class="log-list">
        @foreach (var post in Model.LatestPosts)
        {
            <a class="log-row" asp-page="/Blog/Details" asp-route-slug="@post.Slug">
                <span>@post.Date.ToString("yyyy.MM.dd")</span>
                <strong>@post.Title</strong>
                <small>@post.ReadingTime min read</small>
            </a>
        }
    </div>
</section>
