@page "/resume"
@model Portfolio.Pages.ResumeModel
@{
    ViewData["Title"] = "Resume | System Profile";
    ViewData["Description"] = "Resume for Sawyer Cawthon: Computer Science undergraduate focused on AI, cybersecurity research, ASP.NET Core backend systems, PostgreSQL, and software engineering internships.";
    ViewData["CanonicalPath"] = "/resume";
}

<article class="resume-shell">
    <header class="page-header split-header">
        <div>
            <p class="system-label">system.profile</p>
            <h1>AI, cybersecurity, and backend systems resume.</h1>
        </div>
        <p>Full resume content is rendered from the current resume source, with a downloadable PDF available for recruiters and collaborators.</p>
    </header>

    <section class="profile-grid">
        <aside class="profile-card">
            <p class="system-label">download</p>
            <strong>Resume PDF</strong>
            <span>Download the original resume file for offline review.</span>
            <a class="button" href="@Model.Profile.Links.ResumePdf" download>Download resume PDF</a>
        </aside>
        <div class="prose">
            @Html.Raw(Model.Resume?.Html ?? "<p>Resume content is not available yet.</p>")
        </div>
    </section>
</article>
