@page "/resume"
@model Portfolio.Pages.ResumeModel
@{
    ViewData["Title"] = "Resume | System Profile";
    ViewData["Description"] = "Resume for Sawyer Cawthon: AI-focused software developer with ASP.NET, C#, LLM, knowledge graph, and research experience.";
    ViewData["CanonicalPath"] = "/resume";
}

<article class="resume-shell">
    <header class="page-header split-header">
        <div>
            <p class="system-label">system.profile</p>
            <h1>Technical credibility with product judgment.</h1>
        </div>
        <p>Full resume content is rendered from Markdown, with a downloadable PDF available for recruiters and collaborators.</p>
    </header>

    <section class="profile-grid">
        <aside class="profile-card">
            <p class="system-label">download</p>
            <strong>Resume PDF</strong>
            <span>Download the original resume file for offline review.</span>
            <a class="button" href="/files/sawyer-cawthon-resume.pdf" download>Download resume PDF</a>
        </aside>
        <div class="prose">
            @Html.Raw(Model.Resume?.Html ?? "<p>Resume content is not available yet.</p>")
        </div>
    </section>
</article>
